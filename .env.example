DISCOLAB_LIBRARY_ROOTS=/path/to/lossless:/path/to/lossy

DISCOLAB_DB=out/discolab.db

# Optional. Reading scrobbles needs the API key, not the shared secret.
LASTFM_API_KEY=
LASTFM_USERNAME=

# Optional. Spotify permits plain http on a loopback address; `localhost` is rejected.
# A port that matches this URI must be published for the callback container.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_CALLBACK_PORT=8888

# Only for an https redirect URI served by the callback container.
SPOTIFY_TLS_CERT=
SPOTIFY_TLS_KEY=

# Optional. A Discogs personal access token, not an OAuth app. Search needs it.
DISCOGS_TOKEN=
